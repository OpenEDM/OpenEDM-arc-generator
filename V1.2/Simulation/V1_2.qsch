  «text (3700,7000) 1 7 0 0x1000000 -1 -1 "ï»¿; GENERATOR PARAMETERS\n\n.param t_on = 3Âµ ; on time, [s]\n.param t_off = 47Âµ ; off time, [s]\n.param t_chrg_max = 10Âµ ; max inductor charging time, [s]\n\n.param I_sp = 20 ; inductor current setpoint, [A]\n.param V_main = 144 ; main voltage level, [V]\n.param L = 500Âµ ; main inductor's inductance, [H]\n.param R_L = 1m ; main inductor's series resistance, [Ohm]\n.param R_g = 15 ; FET gate resistor value, [Ohm]\n.param deadtime = 1Âµ ; deadtime, [s]\n\n.param L_p = 1n ; PCB traces parasitic inductance, [H]\n.param L_pw = 1n ; wire parasitic inductance, [H]\n\n; GAP PARAMETERS\n\n.param R_arc = 1 ; arc resistance, [Ohm]\n.param V_gap_br = 100 ; gap breakdown voltage, [V]\n.param t_ign_delay_min = 0.2Âµ ; min ignition delay, [s]\n.param t_ign_delay_max = 0.2Âµ ; max ignition delay, [s]\n.param I_arc_min = 1 ; min arc current, if the arc actual current is less than this value, the arc stops, [A]\n.param t_startup_delay = 0m ; startup delay when arcs don't occur, [s]\n.param R_short = 1 ; gap short resistance, [Ohm]\n.param t_short_timestamp = 3m ; at this timestamp gap short occurs and continues until the end of simulation, [s]\n\n; CALCULATED PARAMETERS\n\n.param T = t_on + t_off ; control period, [s]\n\n; MODELS\n\n.model Q_ideal SW(Ron=.01 Roff=1Meg Vt=.5 Vh=-.1)\n\n; SIMULATION OPTIONS\n\n.options savepowers=1\n.options MAXSTEP=T/1000\n.ic I(L1)=0\n.tran 1m\n\n; PARAMETERS MEASUREMENT\n\n.meas steady_state_start_cycle find V(CURRENT_CONTROL_PERIOD) when I(L1)=I_sp rise=2\n.meas steady_state_last_cycle max V(CURRENT_CONTROL_PERIOD)\n\n.meas analysis_start_time param steady_state_start_cycle * T\n.meas analysis_finish_time param (steady_state_last_cycle -1) * T\n\n.meas #--------------------------------average-powers-----------------------------# param 0\n.meas P_Q1_avg avg P(Q1) from analysis_start_time to analysis_finish_time\n.meas P_Q2_avg avg P(Q2) from analysis_start_time to analysis_finish_time\n.meas P_Q3_avg avg P(Q3) from analysis_start_time to analysis_finish_time\n.meas P_V1_avg avg P(V1) from analysis_start_time to analysis_finish_time\n.meas P_R4_avg avg P(R4) from analysis_start_time to analysis_finish_time\n.meas #---------------------------------max-voltages------------------------------# param 0\n.meas V_Q1_ds_max max V(Q1D, Q1S)\n.meas V_Q2_ds_max max V(Q2D, Q2S)\n.meas V_Q3_ds_max max V(Q3D, Q3S)\n.meas #----------------------------------efficiency-------------------------------# param 0\n.meas efficiency param (p_r4_avg / (-p_v1_avg)) * 100\n\n; PLOTTING\n\n.plot I(L1)\n.plot V(V_ARC) I(R4)\n;.plot P(Q1)\n;.plot V(V_ARC_STM32)\n;.plot V(H_CTRL) V(L_CTRL)\n;.plot P(V1) P(R4) P(Q1) P(Q2) P(Q3)\n;.plot V(Q1,Q1S) V(Q2,Q2S) V(Q3,Q3S)\n.plot V(Q1D,Q1S) V(Q2D,Q2S) V(Q3D,Q3S)"»
